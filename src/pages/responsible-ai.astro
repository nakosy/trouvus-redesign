---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
---
<BaseLayout title="Responsible AI | Trouvus" description="The principles Trouvus applies to responsible AI strategy, design and implementation.">
  <Hero eyebrow="Responsible AI" title="Governance is part of the operating model." lead="Responsible transformation requires clear purpose, accountable decisions and evidence throughout the lifecycle." variant="network" />
  <section><div class="wrap">
    <div class="grid-3">
      <Card as="article" heading="h2" tone="violet" badge="Purpose" title="Value before capability" text="Start with a legitimate business and human objective—not a technology looking for a use." />
      <Card as="article" heading="h2" tone="green" badge="Accountability" title="Humans remain answerable" text="Assign decision rights, escalation paths and operating ownership before deployment." />
      <Card as="article" heading="h2" tone="amber" badge="Evidence" title="Test what matters" text="Evaluate performance, failure modes, bias, privacy, security and real-world operating outcomes." />
      <Card as="article" heading="h2" title="Proportionate controls" text="Match review, documentation and monitoring to the consequence and reversibility of the decision." />
      <Card as="article" heading="h2" title="Human capability" text="Design automation so that judgment, challenge and institutional learning are strengthened rather than hollowed out." />
      <Card as="article" heading="h2" title="Lifecycle governance" text="Monitor systems after launch and define when they must be corrected, suspended or retired." />
    </div>
  </div></section>
</BaseLayout>
