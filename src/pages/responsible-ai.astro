---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---
<BaseLayout title="Responsible AI | Trouvus" description="The principles Trouvus applies to responsible AI strategy, design and implementation.">
  <Hero eyebrow="Responsible AI" title="Governance is part of the operating model." lead="Responsible transformation requires clear purpose, accountable decisions and evidence throughout the lifecycle." variant="network" />
  <section><div class="wrap">
    <div class="grid-3">
      <article class="card"><div class="badge violet">Purpose</div><h2>Value before capability</h2><p class="muted">Start with a legitimate business and human objective—not a technology looking for a use.</p></article>
      <article class="card"><div class="badge green">Accountability</div><h2>Humans remain answerable</h2><p class="muted">Assign decision rights, escalation paths and operating ownership before deployment.</p></article>
      <article class="card"><div class="badge amber">Evidence</div><h2>Test what matters</h2><p class="muted">Evaluate performance, failure modes, bias, privacy, security and real-world operating outcomes.</p></article>
      <article class="card"><h2>Proportionate controls</h2><p class="muted">Match review, documentation and monitoring to the consequence and reversibility of the decision.</p></article>
      <article class="card"><h2>Human capability</h2><p class="muted">Design automation so that judgment, challenge and institutional learning are strengthened rather than hollowed out.</p></article>
      <article class="card"><h2>Lifecycle governance</h2><p class="muted">Monitor systems after launch and define when they must be corrected, suspended or retired.</p></article>
    </div>
  </div></section>
</BaseLayout>
