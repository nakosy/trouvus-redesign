---
import BaseLayout from '../layouts/BaseLayout.astro';
import OperatingSystemVisual from '../components/OperatingSystemVisual.astro';
import Card from '../components/Card.astro';
import StatCard from '../components/StatCard.astro';
import Stepper from '../components/Stepper.astro';
import Pipeline from '../components/Pipeline.astro';

const mckinsey = 'https://www.mckinsey.com/capabilities/quantumblack/our-insights/the-state-of-ai';
const kicker = 'McKinsey Global Survey · August 2026';
const stats = [
  { value: '80%', text: 'of respondents say AI has improved their individual productivity.', cta: 'Read the 2026 survey →' },
  { value: '37%', text: 'report that AI has contributed positively to their organization’s EBIT.', cta: 'See the enterprise-impact findings →' },
  { value: '6%', text: 'qualify as AI high performers, reporting significant value and at least 5% EBIT impact from AI.', cta: 'Review what high performers do differently →' },
];
const gaps = [
  { icon: 'icon-strategy', title: 'Disconnected strategy', text: 'Tools deployed without clear business-model integration.' },
  { icon: 'icon-bizmodel', title: 'Unchanged workflows', text: 'Automation layered over outdated operating processes.' },
  { icon: 'icon-workforce', title: 'Atrophied capability', text: 'Workforce skills replaced rather than augmented.' },
];
const steps = [
  { label: '01 Decide', title: 'Decide where AI creates defensible value', text: 'Identify the opportunities that matter, prioritize them against value, feasibility, risk and readiness, and build a credible transformation roadmap.', href: '/expertise/#strategy', cta: 'AI strategy and roadmaps →', icon: 'icon-strategy' },
  { label: '02 Design & deploy', title: 'Redesign the work, then deploy', text: 'Redesign business models, decisions and workflows; define bounded pilots; govern implementation against measurable outcomes.', href: '/expertise/#implementation', cta: 'Implementation and pilots →', icon: 'icon-implementation' },
  { label: '03 Adopt & scale', title: 'Build the organization that scales it', text: 'Develop leadership alignment, workforce capability, governance and the operating disciplines required to scale beyond the pilot.', href: '/expertise/#workforce', cta: 'Workforce transformation →', icon: 'icon-workforce' },
];
const principles = [
  { icon: 'icon-strategy', title: 'Start with strategic value', text: 'Technology selection follows opportunity prioritization, operating logic and evidence.' },
  { icon: 'icon-bizmodel', title: 'Redesign work', text: 'AI should improve decisions, workflows and value creation—not merely accelerate isolated tasks.' },
  { icon: 'icon-workforce', title: 'Build capability', text: 'Every pilot should strengthen leadership judgment, workforce competence and institutional learning.' },
  { icon: 'icon-implementation', title: 'Measure outcomes', text: 'Success is assessed through operating, strategic and organizational results rather than activity.' },
];
const stages = [
  { icon: 'stage-diagnose', title: 'Diagnose', tip: 'Uncover true capability constraints across data, technology and governance.' },
  { icon: 'stage-prioritize', title: 'Prioritize', tip: 'Convert fragmented use-case lists into a ranked, governed portfolio.' },
  { icon: 'stage-design', title: 'Design', tip: 'Define workflows, decision rights and human-augmented boundaries.' },
  { icon: 'stage-pilot', title: 'Pilot', tip: 'Run bounded tests with strict scale-or-stop decision rules.' },
  { icon: 'stage-scale', title: 'Scale', tip: 'Institutionalize processes, controls and continuous workforce learning.' },
];
const assets = [
  { src: '/images/readiness-diagnostic.svg', alt: 'AI Transformation Readiness Diagnostic', title: 'AI Transformation Readiness Diagnostic', text: 'Assesses strategic alignment, data, technology, governance and workforce capability.' },
  { src: '/images/habmc.svg', alt: 'Human-Augmented Business Model Canvas', title: 'Human-Augmented Business Model Canvas', text: 'Examines how AI changes value creation while preserving critical human agency.' },
  { src: '/images/strategy-to-scale.svg', alt: 'Strategy-to-Scale Framework', title: 'Pilot Passport', text: 'Defines a pilot’s hypothesis, scope, owners, controls, metrics and scale decision.' },
];
const proof = [
  { tone: 'violet', badge: 'Inspectable evidence', title: 'Built on published research', text: 'Ideas are grounded in peer-reviewed work and established business-model frameworks—not vendor hype or unsupported certainty.' },
  { tone: 'green', badge: 'Proprietary methods', title: 'Ideas converted into decision systems', text: 'Diagnostics, canvases and Pilot Passports turn abstract strategy into explicit choices, ownership and evidence requirements.' },
  { tone: 'blue', badge: 'Enterprise-value lens', title: 'Technology evaluated through value', text: 'AI opportunities are examined against strategic relevance, operating feasibility, risk, readiness and capital discipline.' },
  { tone: 'amber', badge: 'Governed experimentation', title: 'Scale-or-stop logic before build', text: 'Every pilot begins with a bounded hypothesis, accountable owners and a pre-committed decision rule.' },
];
---

<BaseLayout title="Trouvus | Research-Grounded AI Transformation" description="Trouvus helps leaders decide where AI creates value, redesign work around it and govern the path from hypothesis to scalable capability.">
  <section class="hero">
    <canvas class="hero-canvas" data-variant="network" aria-hidden="true"></canvas>
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">AI transformation strategy and implementation</div>
        <h1>Turn AI ambition into operating capability.</h1>
        <p class="lead">Trouvus helps leaders decide where AI creates value, redesign work around it, and govern the path from first hypothesis to scalable capability.</p>
        <div class="actions">
          <a class="btn accent" href="/contact/?interest=diagnostic">Request an Executive AI Value Diagnostic</a>
          <a class="btn secondary" href="/approach/">Explore the Strategy-to-Scale Framework</a>
        </div>
      </div>
      <OperatingSystemVisual />
    </div>
  </section>

  <section class="authority-band" aria-label="Trouvus foundations">
    <div class="wrap authority-strip">
      <div class="authority-item"><span>01</span><strong>Peer-reviewed foundations</strong></div>
      <div class="authority-item"><span>02</span><strong>Proprietary transformation frameworks</strong></div>
      <div class="authority-item"><span>03</span><strong>Executive-education perspective</strong></div>
      <div class="authority-item"><span>04</span><strong>Investment-informed judgment</strong></div>
    </div>
  </section>

  <section class="rule">
    <div class="wrap">
      <div class="eyebrow">The 2026 enterprise reality</div>
      <h2>Individual AI gains are rising. Enterprise value still depends on operating redesign.</h2>
      <div class="stat-grid">
        {stats.map((stat) => <StatCard {...stat} kicker={kicker} href={mckinsey} />)}
      </div>
      <p class="small muted mt-sm">Based on 1,719 survey participants across 97 nations; fielded May–June 2026.</p>
      <div class="grid-3 mt-md">
        {gaps.map((gap) => <Card {...gap} />)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">The transformation journey</div>
      <h2>Three moves. One operating system.</h2>
      <Stepper steps={steps} />
    </div>
  </section>

  <section class="rule">
    <div class="wrap split">
      <div>
        <div class="eyebrow">Our point of view</div>
        <h2>Transformation must redesign the system—not simply add tools.</h2>
        <img class="pov-visual" src="/images/pov-steps.svg" loading="lazy" decoding="async" alt="Four moves: strategic value, redesign work, build capability, measure outcomes" width="620" height="190">
      </div>
      <div class="grid-2">
        {principles.map((item) => <Card {...item} />)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">Strategy-to-Scale Framework</div>
      <h2>From strategic uncertainty to scalable capability.</h2>
      <Pipeline stages={stages} />
      <p class="small muted mt-sm">Hover or focus each stage for its executive output. <a href="/approach/" class="card-cta">Full framework →</a></p>
    </div>
  </section>

  <section class="rule">
    <div class="wrap">
      <div class="eyebrow">Intellectual assets</div>
      <h2>Frameworks that make transformation decisions visible.</h2>
      <div class="grid-3">
        {assets.map((asset) => <Card class="tactile glass" muted={false} title={asset.title} text={asset.text} image={{ src: asset.src, alt: asset.alt }} />)}
      </div>
    </div>
  </section>

  <section class="authority-section">
    <div class="wrap split authority-layout">
      <div>
        <div class="eyebrow">Research, method and judgment</div>
        <h2>Serious transformation requires more than technical enthusiasm.</h2>
        <p class="lead">Trouvus combines academic research, structured transformation methods and investment-informed judgment to help leaders make better decisions about where—and where not—to deploy AI.</p>
        <img class="control-center-visual" src="/images/control-center.svg" loading="lazy" decoding="async" alt="Trouvus transformation diagnostic: five-dimension readiness radar and governed portfolio view" width="640" height="460">
      </div>
      <div class="authority-cards">
        {proof.map((item) => <Card class="proof" {...item} />)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap diagnostic-offer">
      <div>
        <div class="eyebrow">Executive AI Value Diagnostic</div>
        <h2>Turn uncertainty into a governed next decision.</h2>
        <p class="lead">A focused 90-minute working session for leaders who need to distinguish a credible AI opportunity from a costly distraction.</p>
        <a class="btn accent" href="/contact/?interest=diagnostic">Request the diagnostic</a>
      </div>
      <div class="diagnostic-outputs" aria-label="Diagnostic outputs">
        <div><span>01</span><strong>Preliminary strategic-opportunity map</strong></div>
        <div><span>02</span><strong>Readiness and risk screen</strong></div>
        <div><span>03</span><strong>One recommended scale-or-stop next step</strong></div>
      </div>
    </div>
  </section>
</BaseLayout>
