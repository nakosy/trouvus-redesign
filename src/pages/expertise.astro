---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceRow from '../components/ServiceRow.astro';
---

<BaseLayout title='Expertise | Trouvus' description='AI strategy, business-model innovation, implementation design, workforce transformation and AI venture advisory.'>
<Hero eyebrow="Expertise" title="Build the capabilities that make AI valuable." lead="Our practices follow the actual transformation journey: deciding where AI matters, redesigning how value is created, implementing credible pilots and building the organization’s capacity to scale." variant="pipeline" /><section><div class="wrap"><ServiceRow id="strategy" icon="icon-strategy" number="01" title="AI Strategy and Transformation Roadmaps" lead="For leaders who need to determine where AI should be deployed, what should happen first and how investment should be governed." mandates="AI readiness assessment · Executive opportunity workshops · Use-case discovery and prioritization · Transformation portfolio design · Business-case development · AI operating-model design · Governance and risk architecture." deliverables="Readiness diagnostic · Prioritized opportunity portfolio · Executive decision map · Transformation roadmap · Governance blueprint · Investment and sequencing model." />
<ServiceRow id="business-model" icon="icon-bizmodel" number="02" title="Business-Model and Operating-Model Innovation" lead="For organizations that need to move beyond process automation and reconsider how AI changes value creation, delivery and capture." mandates="AI-enabled business-model redesign · Customer-value proposition redesign · Operating-model analysis · Process and decision redesign · Capability mapping · Product and service innovation · Ecosystem strategy." deliverables="Human-Augmented Business Model Canvas · Value-creation map · Process and decision architecture · Capability-gap analysis · Operating-model blueprint · Innovation portfolio." />
<ServiceRow id="implementation" icon="icon-implementation" number="03" title="AI Implementation and Pilot Design" lead="For organizations ready to turn a strategic priority into a bounded, governable and measurable deployment." mandates="Pilot definition · Solution architecture · Vendor evaluation · Generative-AI workflow design · Intelligent automation · Decision-support systems · Analytics · Implementation governance." deliverables="Pilot Passport · Functional requirements · Technology architecture · Data-readiness assessment · Implementation plan · KPI framework · Pilot evaluation report." />
<ServiceRow id="workforce" icon="icon-workforce" number="04" title="Workforce Transformation and Executive Capability" lead="For leaders who understand that adoption, judgment and capability are as consequential as the technology itself." mandates="Executive AI education · Leadership alignment · Workforce capability assessment · Role and workflow redesign · Change strategy · Responsible AI training · Custom academies." deliverables="Capability maturity map · Leadership program · Role-transition plans · Learning architecture · Adoption scorecard · Change and communication plan." />
<ServiceRow id="venture" icon="icon-venture" number="05" title="AI Venture and Innovation Advisory" lead="For founders and innovation teams developing AI-enabled products, services and business models." mandates="AI-native business-model design · Venture positioning · Product strategy · Market validation · Monetization design · Investor narrative · Growth planning." deliverables="Venture thesis · Business-model architecture · Product roadmap · Market-entry strategy · Investor narrative · Growth milestones." /></div></section>
</BaseLayout>
