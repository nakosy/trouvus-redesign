---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Request Received | Trouvus" description="Your Executive AI Value Diagnostic request has been received." noIndex={true}>
  <section class="page-hero">
    <canvas class="hero-canvas" data-variant="pipeline"></canvas>
    <div class="wrap">
      <div class="eyebrow">Request received</div>
      <h1>Thank you. We will review your context carefully.</h1>
      <p class="lead">Your Executive AI Value Diagnostic request has been submitted. Trouvus will respond from <strong>info@trouvus.com</strong>.</p>
      <div class="actions">
        <a class="btn accent" href="/insights/">Explore Trouvus Insights</a>
        <a class="btn secondary" href="/">Return to the homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>
