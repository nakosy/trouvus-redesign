---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout title='Perspectives | Trouvus' description='The research foundations, original frameworks and transformation standards behind the Trouvus approach to enterprise AI.'>
<Hero eyebrow="Perspectives" title="Research-grounded frameworks. Rigorous standards." lead="Trouvus combines academic rigor, executive education, investment-informed judgment and the operating discipline required to move enterprise AI from ambition to measurable capability." variant="network" />

<section><div class="wrap"><div class="eyebrow">Research foundations</div><h2>Published, peer-reviewed and public.</h2><div class="grid-3">
<Card class="proof" tone="violet" badge="Research evidence" title="Knowledge-Based Social Entrepreneurship" text="A research monograph by our founder, published by Palgrave Macmillan, examining how knowledge, innovation and entrepreneurship interact in the modern economy."><a class="source-link" href="https://link.springer.com/book/10.1057/978-1-137-34809-8" target="_blank" rel="noopener">View the publisher record →</a></Card>
<Card class="proof" tone="violet" badge="Research evidence" title="Peer-reviewed publications" text="More than thirty peer-reviewed papers spanning AI strategy, generative-AI governance, human-AI co-creation, knowledge management and digital transformation." />
<Card class="proof" tone="violet" badge="Research evidence" title="Academic leadership" text="Conference chairing and programme leadership in the European AI research community, alongside university teaching in digital transformation." />
</div></div></section>

<section class="rule"><div class="wrap"><div class="eyebrow">Original frameworks</div><h2>Tools that make transformation decisions visible.</h2><p class="lead">Each framework is proprietary Trouvus intellectual property, developed from research and translated through executive education and practical decision design.</p>
<div class="grid-3">
<Card class="tactile" image={{ src: "/images/strategy-to-scale.svg", alt: "Strategy-to-Scale Framework diagram: Diagnose, Prioritize, Design, Pilot, Scale" }} title="Strategy-to-Scale Framework" text="A five-stage operating discipline—Diagnose, Prioritize, Design, Pilot, Scale—for moving from uncertainty to governed capability."><a href="/approach/">Explore the framework →</a></Card>
<Card class="tactile" image={{ src: "/images/readiness-diagnostic.svg", alt: "AI Transformation Readiness Diagnostic radar across five capability dimensions" }} title="AI Transformation Readiness Diagnostic" text="Assesses strategic alignment, data, technology, governance and workforce capability before a single tool is selected."><a href="/expertise/#strategy">Where it is used →</a></Card>
<Card class="tactile" image={{ src: "/images/habmc.svg", alt: "Human-Augmented Business Model Canvas grid" }} title="Human-Augmented Business Model Canvas" text="A business-model lens for deciding where machines should automate, where they should augment and where human judgment must remain load-bearing."><a href="/insights/human-augmented-business-model-canvas/">Read the framework article →</a></Card>
</div></div></section>

<section class="rule"><div class="wrap"><div class="eyebrow">Illustrative scenarios</div><h2>How value could be created—shown honestly.</h2><p class="lead">The scenarios below are hypothetical models. They exist to make our methods concrete, not to imply completed client engagements.</p>
<div class="grid-2">
<Card class="proof" tone="amber" badge="Illustrative scenario — hypothetical" title="Mid-market professional-services firm" text="A 400-person advisory firm applies the Readiness Diagnostic and discovers its constraint is not model access but unstructured knowledge capture. A bounded pilot restructures proposal development around a retrieval-augmented workflow, governed by a Pilot Passport with explicit quality and confidentiality controls, before any firm-wide rollout decision." />
<Card class="proof" tone="amber" badge="Illustrative scenario — hypothetical" title="Regional manufacturer" text="A manufacturer under margin pressure uses the Human-Augmented Business Model Canvas to separate decisions that can be automated (scheduling, anomaly detection) from those that must stay human-led (supplier negotiation, safety judgment). The resulting portfolio sequences three pilots by value, feasibility and workforce readiness rather than by vendor enthusiasm." />
</div></div></section>

<section class="rule"><div class="wrap"><div class="eyebrow">The Trouvus operating standard</div><h2>Designed for impact. Governed for certainty.</h2><div class="grid-3">
<Card class="proof" tone="violet" badge="Research-grounded methodology" title="Academic rigor, enterprise relevance" text="Decisions are built on published research, established business-model methods and explicit evidence—not vendor enthusiasm." />
<Card class="proof" tone="green" badge="Governed execution" title="Pre-committed pilot metrics" text="Every initiative begins with an explicit hypothesis, accountable owner, risk controls and a scale, iterate or stop decision rule." />
<Card class="proof" tone="amber" badge="Capability retention" title="Human agency at the core" text="Systems are designed to remove routine toil while strengthening leadership judgment, workforce competence and institutional learning." />
</div></div></section>

<CTA flush eyebrow="Executive AI Value Diagnostic" title="Test the frameworks against your own priorities." text="A focused working session applies the diagnostic lens to your strategic context—no tooling decision required." href="/contact/?interest=diagnostic" label="Request the diagnostic" />
</BaseLayout>
