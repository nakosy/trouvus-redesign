---
interface Props { title: string; text: string; label?: string; href?: string; eyebrow?: string; flush?: boolean; }
const { title, text, label = 'Request the diagnostic', href = '/contact/?interest=diagnostic', eyebrow, flush = false } = Astro.props;
---
<section class:list={{ 'cta-section': !flush }}>
  <div class="wrap">
    <div class="cta">
      <div>
        {eyebrow && <div class="eyebrow">{eyebrow}</div>}
        <h2>{title}</h2>
        <p class={eyebrow || flush ? 'muted' : undefined}>{text}</p>
      </div>
      <a class="btn accent" href={href}>{label}</a>
    </div>
  </div>
</section>
