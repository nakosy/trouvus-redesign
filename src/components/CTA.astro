---
interface Props { title: string; text: string; label?: string; href?: string; }
const { title, text, label = 'Request the diagnostic', href = '/contact/?interest=diagnostic' } = Astro.props;
---
<section class="cta-section">
  <div class="wrap">
    <div class="cta">
      <div><h2>{title}</h2><p>{text}</p></div>
      <a class="btn accent" href={href}>{label}</a>
    </div>
  </div>
</section>
